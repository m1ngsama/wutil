{
  "name": "wutil",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node -e \"const fs=require('fs');const f='out/sw.js';fs.writeFileSync(f,fs.readFileSync(f,'utf8').replace('__BUILD_ID__',fs.readFileSync('.next/BUILD_ID','utf8').trim()))\"",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "purge:cf": "node scripts/purge-cloudflare-cache.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.8.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^25.6.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3"
  }
}
